{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-articles",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron/fetch-viral",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-database",
      "schedule": "0 0 * * *"
    }
  ]
}