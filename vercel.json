{
    "buildCommand": "npm run build && node scripts/move-api.js",
    "outputDirectory": ".vercel/output/static",
    "devCommand": "npm run dev",
    "framework": "vite",
    "functions": {
      "api/cron/fetch-news.js": {
        "runtime": "nodejs20.x",
        "memory": 1024,
        "maxDuration": 300
      },
      "api/cron/fetch-viral.js": {
        "runtime": "nodejs20.x",
        "memory": 1024,
        "maxDuration": 300
      },
      "api/cron/fetch-history.js": {
        "runtime": "nodejs20.x",
        "memory": 1024,
        "maxDuration": 300
      },
      "api/cron/generate-site.js": {
        "runtime": "nodejs20.x",
        "memory": 1024,
        "maxDuration": 300
      }
    },
    "crons": [
      {
        "path": "/api/cron/fetch-news",
        "schedule": "0 5,11,17 * * *"
      },
      {
        "path": "/api/cron/generate-site",
        "schedule": "0 6,12,18 * * *"
      },
      {
        "path": "/api/cron/fetch-viral",
        "schedule": "0 3 * * *"
      },
      {
        "path": "/api/cron/fetch-history",
        "schedule": "30 14 * * 6"
      }
    ]
  }