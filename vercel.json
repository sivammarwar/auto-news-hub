{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "devCommand": "npm run dev",
    "framework": "vite",
    "crons": [
      {
        "path": "/api/cron/fetch-news",
        "schedule": "0 6 * * *"
      },
      {
        "path": "/api/cron/fetch-viral",
        "schedule": "0 3 * * *"
      },
      {
        "path": "/api/cron/fetch-history",
        "schedule": "30 14 * * 6"
      }
    ]
  }